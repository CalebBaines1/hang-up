# Copy to .env and fill in. Never commit the real file.

# Nebius Token Factory (OpenAI-compatible). Required.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# NVIDIA Nemotron models on Token Factory
PERSONA_MODEL=nvidia/nemotron-3-super-120b-a12b
JUDGE_MODEL=nvidia/nemotron-3-super-120b-a12b

# Speech service (NVIDIA Parakeet STT + Kokoro TTS, see services/speech).
# Leave empty to fall back to the browser's built-in speech.
SPEECH_URL=http://localhost:8001

PORT=8787
DB_PATH=./data/hangup.db
# Comma-separated origins allowed to call the API (the web app's URL)
CORS_ORIGIN=http://localhost:5173

# Web Push keys. Generated and stored in the database if left empty.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com

# Optional: Tavily for live scam alerts
TAVILY_API_KEY=
